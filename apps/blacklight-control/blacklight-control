#!/usr/bin/env python3
"""Blacklight Control: user-scoped KDE Connect command helper and agent."""
from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
from datetime import datetime, timezone
from pathlib import Path

APP_NAME = "blacklight-control"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / APP_NAME
STATE_FILE = STATE_DIR / "state.json"
MAX_MESSAGE_LENGTH = 240
HEARTBEAT_SECONDS = 10
HEARTBEAT_TIMEOUT = 35
_STOP_EVENT = threading.Event()


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def load_state() -> dict:
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    temporary = STATE_FILE.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    temporary.chmod(0o600)
    os.replace(temporary, STATE_FILE)


def record(action: str, message: str | None = None) -> None:
    data = load_state()
    data.update({"last_action": action, "updated_at": now()})
    if message is not None:
        data["message"] = message
    else:
        data.pop("message", None)
    save_state(data)


def agent_is_active(state: dict) -> bool:
    stamp = state.get("agent_heartbeat")
    pid = state.get("agent_pid")
    if not isinstance(stamp, str) or not isinstance(pid, int):
        return False
    try:
        heartbeat = datetime.fromisoformat(stamp)
        age = (datetime.now(timezone.utc) - heartbeat).total_seconds()
        if age < 0 or age > HEARTBEAT_TIMEOUT:
            return False
        os.kill(pid, 0)
        return True
    except (ValueError, ProcessLookupError, PermissionError, OSError):
        return False


def status() -> int:
    state = load_state()
    active = agent_is_active(state)
    print("Blacklight Control")
    print(f"Agent service: {'active' if active else 'inactive'}")
    heartbeat = state.get("agent_heartbeat", "unavailable")
    print(f"Agent heartbeat: {heartbeat}")
    print(f"Last action: {state.get('last_action', 'none')}")
    print(f"Last action time: {state.get('updated_at', 'never')}")
    print("Native lock: KDE authentication; visual lockdown: dismissible fullscreen notice")
    return 0


def _stop_handler(_signum: int, _frame: object) -> None:
    _STOP_EVENT.set()


def run_agent() -> int:
    signal.signal(signal.SIGTERM, _stop_handler)
    signal.signal(signal.SIGINT, _stop_handler)
    pid = os.getpid()
    print(f"Blacklight Control agent started (PID {pid}).", flush=True)
    try:
        while not _STOP_EVENT.is_set():
            state = load_state()
            state["agent_pid"] = pid
            state["agent_heartbeat"] = now()
            save_state(state)
            _STOP_EVENT.wait(HEARTBEAT_SECONDS)
    finally:
        state = load_state()
        if state.get("agent_pid") == pid:
            state.pop("agent_pid", None)
            state.pop("agent_heartbeat", None)
            save_state(state)
        print("Blacklight Control agent stopped.", flush=True)
    return 0


def lock_session() -> int:
    # Plasma exposes the native screen locker on the user's session bus.
    # Prefer this over logind: KDE Connect Run Commands may not have a
    # reliable logind "self" session identifier in their process context.
    dbus_calls = [
        ["qdbus6", "org.freedesktop.ScreenSaver", "/ScreenSaver", "Lock"],
        ["qdbus", "org.freedesktop.ScreenSaver", "/ScreenSaver", "Lock"],
        [
            "dbus-send", "--session", "--type=method_call",
            "--dest=org.freedesktop.ScreenSaver",
            "/ScreenSaver", "org.freedesktop.ScreenSaver.Lock",
        ],
    ]
    attempted = set()
    for command in dbus_calls:
        executable = shutil.which(command[0])
        if not executable or executable in attempted:
            continue
        attempted.add(executable)
        result = subprocess.run(
            [executable, *command[1:]],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode == 0:
            record("lock-requested")
            print("KDE desktop lock requested. Use your normal account authentication to unlock.")
            return 0

    # Fallback only when the caller has an explicit session ID. Avoid
    # loginctl's no-ID behavior, which can target every session.
    loginctl = shutil.which("loginctl")
    session_id = os.environ.get("XDG_SESSION_ID")
    if loginctl and session_id:
        result = subprocess.run(
            [loginctl, "lock-session", session_id],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode == 0:
            record("lock-requested")
            print("Native session lock requested. Use your normal account authentication to unlock.")
            return 0

    print(
        "Could not request the KDE screen lock. Run this from the logged-in KDE desktop "
        "so its session D-Bus is available; check that the Screen Locker is enabled.",
        file=sys.stderr,
    )
    return 1

def show_lockdown(message: str) -> int:
    """Show a fullscreen, visibly dismissible notice; this is not a security lock."""
    cleaned = " ".join(message.split()) or "This screen is temporarily locked."
    if len(cleaned) > MAX_MESSAGE_LENGTH:
        print(f"Message must be {MAX_MESSAGE_LENGTH} characters or fewer.", file=sys.stderr)
        return 2
    try:
        import tkinter as tk
    except ModuleNotFoundError:
        print("Blacklight Lockdown needs Python Tkinter. Install it with: sudo apt install python3-tk", file=sys.stderr)
        return 1
    record("lockdown-active", cleaned)
    root = tk.Tk()
    root.title("Blacklight Control — Lockdown")
    root.configure(bg="#020604")
    root.attributes("-fullscreen", True)
    root.attributes("-topmost", True)
    root.bind("<Escape>", lambda _event: root.destroy())
    root.bind("<F10>", lambda _event: root.destroy())
    shell = tk.Frame(root, bg="#020604", highlightbackground="#39ff83", highlightthickness=2)
    shell.place(relx=0.5, rely=0.5, anchor="center", relwidth=0.72, relheight=0.72)
    tk.Label(shell, text="BLACKLIGHT CONTROL", bg="#020604", fg="#39ff83", font=("monospace", 16, "bold")).pack(pady=(42, 12))
    tk.Label(shell, text="SESSION NOTICE", bg="#020604", fg="#baffd1", font=("monospace", 34, "bold")).pack(pady=(12, 24))
    tk.Frame(shell, bg="#1c7540", height=2).pack(fill="x", padx=60, pady=8)
    tk.Label(shell, text=cleaned, bg="#020604", fg="#e6ffed", font=("sans", 20), wraplength=760, justify="center").pack(expand=True, padx=48, pady=24)
    tk.Label(shell, text="Visual notice only — not an authentication barrier.", bg="#020604", fg="#77a98a", font=("monospace", 11)).pack(pady=(4, 10))
    tk.Button(shell, text="EXIT LOCKDOWN  [ ESC ]", command=root.destroy, bg="#0b2816", fg="#baffd1", activebackground="#174d2b", activeforeground="#ffffff", relief="flat", padx=28, pady=14, font=("monospace", 13, "bold"), cursor="hand2").pack(pady=(8, 34))
    root.mainloop()
    record("lockdown-ended")
    return 0


def show_message(message: str) -> int:
    cleaned = " ".join(message.split())
    if not cleaned:
        print("Message cannot be empty.", file=sys.stderr)
        return 2
    if len(cleaned) > MAX_MESSAGE_LENGTH:
        print(f"Message must be {MAX_MESSAGE_LENGTH} characters or fewer.", file=sys.stderr)
        return 2
    kdialog = shutil.which("kdialog")
    if not kdialog:
        print("kdialog is not installed; cannot display a desktop message.", file=sys.stderr)
        return 1
    record("message-shown", cleaned)
    return subprocess.run([kdialog, "--title", "Blacklight Control", "--msgbox", cleaned], check=False).returncode


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=APP_NAME, description="Blacklight Control user-session agent")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status", help="Show agent and last-action status")
    sub.add_parser("daemon", help="Run the background user-session agent")
    sub.add_parser("lock", help="Request the native KDE session lock")
    lockdown = sub.add_parser("lockdown", help="Show a fullscreen Blacklight notice with local exit")
    lockdown.add_argument("text", nargs="*", help="Optional notice text (maximum 240 characters)")
    message = sub.add_parser("message", help="Show a message on this desktop")
    message.add_argument("text", nargs="+", help="Message text (maximum 240 characters)")
    sub.add_parser("clear-state", help="Clear the last-action record")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.command == "status":
        return status()
    if args.command == "daemon":
        return run_agent()
    if args.command == "lock":
        return lock_session()
    if args.command == "lockdown":
        return show_lockdown(" ".join(args.text))
    if args.command == "message":
        return show_message(" ".join(args.text))
    if args.command == "clear-state":
        state = load_state()
        state.pop("last_action", None)
        state.pop("updated_at", None)
        state.pop("message", None)
        save_state(state)
        print("Last-action record cleared; agent service and session state are unchanged.")
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
