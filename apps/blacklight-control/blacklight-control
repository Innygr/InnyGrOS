#!/usr/bin/env python3
"""Blacklight Control: user-scoped KDE Connect command helper and agent."""
from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

APP_NAME = "blacklight-control"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / APP_NAME
STATE_FILE = STATE_DIR / "state.json"
MAX_MESSAGE_LENGTH = 240
HEARTBEAT_SECONDS = 10
HEARTBEAT_TIMEOUT = 35
_STOP = False


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def load_state() -> dict:
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    temporary = STATE_FILE.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    temporary.chmod(0o600)
    os.replace(temporary, STATE_FILE)


def record(action: str, message: str | None = None) -> None:
    data = load_state()
    data.update({"last_action": action, "updated_at": now()})
    if message is not None:
        data["message"] = message
    else:
        data.pop("message", None)
    save_state(data)


def agent_is_active(state: dict) -> bool:
    stamp = state.get("agent_heartbeat")
    pid = state.get("agent_pid")
    if not isinstance(stamp, str) or not isinstance(pid, int):
        return False
    try:
        heartbeat = datetime.fromisoformat(stamp)
        age = (datetime.now(timezone.utc) - heartbeat).total_seconds()
        if age < 0 or age > HEARTBEAT_TIMEOUT:
            return False
        os.kill(pid, 0)
        return True
    except (ValueError, ProcessLookupError, PermissionError, OSError):
        return False


def status() -> int:
    state = load_state()
    active = agent_is_active(state)
    print("Blacklight Control")
    print(f"Agent service: {'active' if active else 'inactive'}")
    print(f"Last action: {state.get('last_action', 'none')}")
    print(f"Updated: {state.get('updated_at', 'never')}")
    print("Session lock: native desktop lock (authentication remains required)")
    return 0


def _stop_handler(_signum: int, _frame: object) -> None:
    global _STOP
    _STOP = True


def run_agent() -> int:
    signal.signal(signal.SIGTERM, _stop_handler)
    signal.signal(signal.SIGINT, _stop_handler)
    pid = os.getpid()
    print(f"Blacklight Control agent started (PID {pid}).", flush=True)
    try:
        while not _STOP:
            state = load_state()
            state["agent_pid"] = pid
            state["agent_heartbeat"] = now()
            save_state(state)
            time.sleep(HEARTBEAT_SECONDS)
    finally:
        state = load_state()
        if state.get("agent_pid") == pid:
            state.pop("agent_pid", None)
            state.pop("agent_heartbeat", None)
            save_state(state)
        print("Blacklight Control agent stopped.", flush=True)
    return 0


def lock_session() -> int:
    loginctl = shutil.which("loginctl")
    if not loginctl:
        print("loginctl was not found; cannot request a native session lock.", file=sys.stderr)
        return 1
    result = subprocess.run(
        [loginctl, "lock-session", "self"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        print(result.stderr.strip() or "The desktop session manager rejected the lock request.", file=sys.stderr)
        return result.returncode
    record("lock-requested")
    print("Native session lock requested. Sign in normally on the laptop to unlock.")
    return 0


def show_message(message: str) -> int:
    cleaned = " ".join(message.split())
    if not cleaned:
        print("Message cannot be empty.", file=sys.stderr)
        return 2
    if len(cleaned) > MAX_MESSAGE_LENGTH:
        print(f"Message must be {MAX_MESSAGE_LENGTH} characters or fewer.", file=sys.stderr)
        return 2
    kdialog = shutil.which("kdialog")
    if not kdialog:
        print("kdialog is not installed; cannot display a desktop message.", file=sys.stderr)
        return 1
    record("message-shown", cleaned)
    return subprocess.run([kdialog, "--title", "Blacklight Control", "--msgbox", cleaned], check=False).returncode


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=APP_NAME, description="Blacklight Control user-session agent")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status", help="Show agent and last-action status")
    sub.add_parser("daemon", help="Run the background user-session agent")
    sub.add_parser("lock", help="Request the native KDE session lock")
    message = sub.add_parser("message", help="Show a message on this desktop")
    message.add_argument("text", nargs="+", help="Message text (maximum 240 characters)")
    sub.add_parser("clear-state", help="Clear the last-action record")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.command == "status":
        return status()
    if args.command == "daemon":
        return run_agent()
    if args.command == "lock":
        return lock_session()
    if args.command == "message":
        return show_message(" ".join(args.text))
    if args.command == "clear-state":
        state = load_state()
        state.pop("last_action", None)
        state.pop("updated_at", None)
        state.pop("message", None)
        save_state(state)
        print("Last-action record cleared; agent service and session state are unchanged.")
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
