#!/usr/bin/env bash
set -Eeuo pipefail

DATA_DIR="${HOME}/.local/share/innygros"
THEME_FILE="${DATA_DIR}/config/themes/InnyGrOS.colors"
WALLPAPER_SCRIPT="${DATA_DIR}/scripts/apply-wallpaper.sh"
TERMINAL_SCRIPT="${DATA_DIR}/scripts/apply-terminal-profile.sh"
GAME_CHECK_SCRIPT="${DATA_DIR}/scripts/game-readiness.sh"

if ! command -v kdialog >/dev/null 2>&1; then
  printf 'InnyGrOS Welcome Center needs kdialog. Install it with your graphical software center.\n' >&2
  exit 1
fi

show_info() { kdialog --title "InnyGrOS" --msgbox "$1"; }

open_app() {
  local app="$1"
  if command -v "$app" >/dev/null 2>&1; then "$app" >/dev/null 2>&1 &
  else show_info "$2 is not installed. Open Discover to install it."
  fi
}

apply_theme() {
  if [[ ! -f "${THEME_FILE}" ]]; then
    show_info "The InnyGrOS color scheme was not found. Re-run the InnyGrOS setup from its repository."
    return
  fi
  local target="${HOME}/.local/share/color-schemes/InnyGrOS.colors"
  mkdir -p "$(dirname -- "${target}")"
  if [[ -f "${target}" ]]; then cp -p "${target}" "${target}.backup.$(date +%Y%m%d-%H%M%S)"; fi
  install -m 0644 "${THEME_FILE}" "${target}"
  if command -v plasma-apply-colorscheme >/dev/null 2>&1 && plasma-apply-colorscheme InnyGrOS; then
    show_info "InnyGrOS colors applied. Some applications may need to be restarted."
  else
    show_info "The color scheme is installed. Open System Settings → Colors & Themes → Colors and select InnyGrOS."
  fi
}

show_diagnostics() {
  local report
  report="$(mktemp)"
  {
    echo "InnyGrOS system diagnostics"
    echo "Generated: $(date)"
    echo
    echo "=== Operating system ==="
    if [[ -r /etc/os-release ]]; then cat /etc/os-release; else echo "OS details unavailable"; fi
    echo
    echo "=== Kernel ==="; uname -a
    echo
    echo "=== CPU ==="; if command -v lscpu >/dev/null 2>&1; then lscpu; else echo "lscpu not installed"; fi
    echo
    echo "=== Memory ==="; if command -v free >/dev/null 2>&1; then free -h; else echo "free not installed"; fi
    echo
    echo "=== Storage ==="; if command -v df >/dev/null 2>&1; then df -h -x tmpfs -x devtmpfs; fi
    echo
    echo "=== Power profile ==="
    if command -v powerprofilesctl >/dev/null 2>&1; then powerprofilesctl get 2>&1 || true; echo; powerprofilesctl list 2>&1 || true
    else echo "power-profiles-daemon CLI not detected"; fi
    echo
    echo "This report only reads system information; it does not change settings."
  } > "${report}"
  kdialog --title "InnyGrOS System Diagnostics" --textbox "${report}" 760 560 || true
  rm -f -- "${report}"
}

while true; do
  choice="$(kdialog --title "InnyGrOS Welcome Center" --menu \
    "Welcome to InnyGrOS. What would you like to do?" \
    "settings" "Open System Settings" \
    "discover" "Open Discover (software and updates)" \
    "files" "Open File Manager" \
    "theme" "Apply InnyGrOS colors" \
    "wallpaper" "Install / apply InnyGrOS wallpaper" \
    "terminal-profile" "Install InnyGrOS terminal theme" \
    "game-readiness" "Check Minecraft / Windows game readiness" \
    "terminal" "Open Terminal (advanced)" \
    "diagnostics" "View system diagnostics" \
    "repo" "Open InnyGrOS project page" \
    "about" "About InnyGrOS" \
    "quit" "Exit" 2>/dev/null)" || exit 0
  case "${choice}" in
    settings) open_app systemsettings "System Settings" ;;
    discover) open_app plasma-discover "Discover" ;;
    files) open_app dolphin "Dolphin File Manager" ;;
    theme) apply_theme ;;
    wallpaper)
      if [[ -x "${WALLPAPER_SCRIPT}" ]]; then "${WALLPAPER_SCRIPT}" || show_info "Wallpaper setup could not be completed. See the terminal output for details."
      else show_info "Wallpaper helper missing. Re-run the InnyGrOS Welcome Center installer."
      fi
      ;;
    terminal-profile)
      if [[ -x "${TERMINAL_SCRIPT}" ]]; then "${TERMINAL_SCRIPT}" || show_info "Terminal profile setup did not complete. See the terminal output for details."
      else show_info "Terminal profile helper missing. Re-run the InnyGrOS Welcome Center installer."
      fi
      ;;
    game-readiness)
      if [[ -x "${GAME_CHECK_SCRIPT}" ]]; then "${GAME_CHECK_SCRIPT}" || show_info "The game readiness check could not complete."
      else show_info "Game readiness checker missing. Re-run the InnyGrOS Welcome Center installer."
      fi
      ;;
    terminal) open_app konsole "Konsole" ;;
    diagnostics) show_diagnostics ;;
    repo)
      if command -v xdg-open >/dev/null 2>&1; then xdg-open "https://github.com/Innygr/InnyGrOS" >/dev/null 2>&1 &
      else show_info "Project: https://github.com/Innygr/InnyGrOS"
      fi
      ;;
    about) show_info "InnyGrOS 0.4 — Desktop Edition\n\nKubuntu + KDE Plasma customization project.\n\nEarly experimental software: changes are limited to your user profile unless you explicitly install packages through system tools." ;;
    quit) exit 0 ;;
  esac
done
