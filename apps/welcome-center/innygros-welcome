#!/usr/bin/env bash
set -Eeuo pipefail

DATA_DIR="${HOME}/.local/share/innygros"
LOG_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/innygros"
LOG_FILE="${LOG_DIR}/welcome-center.log"
REPO_URL="https://github.com/Innygr/InnyGrOS"
FIRST_RUN_MARKER="${XDG_STATE_HOME:-${HOME}/.local/state}/innygros/first-run-done"
AUTOSTART_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/autostart/innygros-welcome.desktop"

# Use the helpers next to this file when it is run from a repository checkout,
# otherwise the copies installed by scripts/install-welcome-center.sh.
SELF_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
if [[ "$(basename -- "${SELF_DIR}")" == welcome-center && -f "${SELF_DIR}/../../scripts/desktop-profile.sh" ]]; then
  BASE_DIR="$(cd -- "${SELF_DIR}/../.." && pwd)"
else
  BASE_DIR="${DATA_DIR}"
fi
SCRIPTS_DIR="${BASE_DIR}/scripts"
VERSION="$(head -n 1 "${BASE_DIR}/VERSION" 2>/dev/null || echo unknown)"

if ! command -v kdialog >/dev/null 2>&1; then
  printf 'InnyGrOS Welcome Center needs kdialog. Install it with your graphical software center.\n' >&2
  exit 1
fi
if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
  printf 'InnyGrOS Welcome Center needs a graphical desktop session.\n' >&2
  exit 1
fi

has_command() { command -v "$1" >/dev/null 2>&1; }

show_info() { kdialog --title "InnyGrOS" --icon innygros --msgbox "$1" >/dev/null 2>&1 || true; }

# Show an error with the last lines of a helper's output as expandable details.
show_error() {
  local message="$1" details="${2:-}"
  if [[ -n "${details}" ]]; then
    kdialog --title "InnyGrOS" --detailederror "${message}" "${details}" >/dev/null 2>&1 || true
  else
    kdialog --title "InnyGrOS" --error "${message}" >/dev/null 2>&1 || true
  fi
}

open_app() {
  local app="$1" label="$2"
  if has_command "${app}"; then
    "${app}" >/dev/null 2>&1 </dev/null &
    disown 2>/dev/null || true
  else
    show_info "${label} is not installed. Open Discover to install it."
  fi
}

# Run a bundled helper script. Output goes to a log file (never a terminal
# prompt), stdin is closed so nothing can wait for keyboard input, and a
# failure is shown with the helper's last output lines.
run_helper() {
  local label="$1" script="${SCRIPTS_DIR}/$2"; shift 2
  if [[ ! -f "${script}" ]]; then
    show_error "${label}: helper not found.\n\nExpected: ${script}\n\nRe-run scripts/install-welcome-center.sh from the InnyGrOS repository."
    return 0
  fi
  mkdir -p -- "${LOG_DIR}"
  local output status=0
  output="$(mktemp)"
  bash -- "${script}" "$@" </dev/null >"${output}" 2>&1 || status=$?
  {
    printf '\n=== %s: %s %s (exit %s) ===\n' "$(date '+%F %T')" "$(basename -- "${script}")" "$*" "${status}"
    cat -- "${output}"
  } >> "${LOG_FILE}" 2>/dev/null || true
  if ((status != 0)); then
    show_error "${label} did not complete (exit code ${status}).\n\nFull log: ${LOG_FILE}" "$(tail -n 20 -- "${output}")"
  fi
  rm -f -- "${output}"
  return 0
}

# Optional: open the Welcome Center when the user logs in. Only a file this
# function created (marked X-InnyGrOS-Autostart) is ever removed.
toggle_autostart() {
  if [[ -f "${AUTOSTART_FILE}" ]]; then
    if grep -q '^X-InnyGrOS-Autostart=true$' "${AUTOSTART_FILE}"; then
      rm -f -- "${AUTOSTART_FILE}"
      show_info "The Welcome Center will no longer open at login."
    else
      show_error "${AUTOSTART_FILE} was not created by InnyGrOS, so it was left unchanged."
    fi
    return 0
  fi
  local exec_path="${HOME}/.local/bin/innygros-welcome"
  [[ -x "${exec_path}" ]] || exec_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
  mkdir -p -- "$(dirname -- "${AUTOSTART_FILE}")"
  printf '%s\n' \
    "[Desktop Entry]" \
    "Type=Application" \
    "Name=InnyGrOS Welcome Center" \
    "Comment=Open the InnyGrOS Welcome Center at login" \
    "Exec=${exec_path}" \
    "Icon=innygros" \
    "Terminal=false" \
    "X-InnyGrOS-Autostart=true" > "${AUTOSTART_FILE}"
  chmod 0644 -- "${AUTOSTART_FILE}"
  show_info "The Welcome Center will open each time you log in.\n\nTurn this off from the same menu item, or in System Settings → Autostart."
}

# First-steps guide: offered once, on the first launch, and from the menu.
# Steps run in a safe order: measure before changing anything.
first_steps() {
  kdialog --title "Welcome to InnyGrOS" --icon innygros --msgbox \
    "Welcome to InnyGrOS ${VERSION}.\n\nThis short guide offers the usual first steps. Nothing changes without your choice, and every desktop change can be undone with \"Restore previous desktop settings\".\n\nYou can open this guide again from the menu at any time." >/dev/null 2>&1 || true
  local picked
  picked="$(kdialog --title "InnyGrOS first steps" --icon innygros --separate-output --checklist \
    "Choose what to do now (in this order):" \
    baseline "1. Save a baseline performance snapshot (read-only, before any changes)" on \
    hardware "2. Run the laptop hardware check (read-only)" on \
    profile "3. Apply the InnyGrOS desktop look (snapshot first, reversible)" on \
    terminal "4. Install the InnyGrOS terminal theme" off \
    autostart "5. Show the Welcome Center each time I log in" off 2>/dev/null)" || picked=""
  mkdir -p -- "$(dirname -- "${FIRST_RUN_MARKER}")"
  date '+%F %T' > "${FIRST_RUN_MARKER}" 2>/dev/null || true
  [[ -n "${picked}" ]] || return 0
  if grep -qx baseline <<<"${picked}"; then run_helper "Baseline performance snapshot" performance-benchmark.sh --gui --save; fi
  if grep -qx hardware <<<"${picked}"; then run_helper "Hardware check" hardware-check.sh --gui; fi
  if grep -qx profile <<<"${picked}"; then run_helper "Desktop profile" desktop-profile.sh apply --gui; fi
  if grep -qx terminal <<<"${picked}"; then run_helper "Terminal theme setup" apply-terminal-profile.sh; fi
  if grep -qx autostart <<<"${picked}" && [[ ! -f "${AUTOSTART_FILE}" ]]; then toggle_autostart; fi
  show_info "First steps finished.\n\nNext ideas: \"Check Minecraft / Windows game readiness\", \"Power mode\", and after a few days of use, another performance snapshot to compare with your baseline."
}

show_diagnostics() {
  local report
  report="$(mktemp)"
  {
    echo "InnyGrOS system diagnostics"
    echo "Generated: $(date)"
    echo
    echo "=== Operating system ==="
    if [[ -r /etc/os-release ]]; then cat /etc/os-release; else echo "OS details unavailable"; fi
    echo
    echo "=== Kernel ==="; uname -a
    echo
    echo "=== CPU ==="; if has_command lscpu; then lscpu; else echo "lscpu not installed"; fi
    echo
    echo "=== Memory ==="; if has_command free; then free -h; else echo "free not installed"; fi
    echo
    echo "=== Storage ==="; if has_command df; then df -h -x tmpfs -x devtmpfs 2>/dev/null || true; fi
    echo
    echo "=== Power profile ==="
    if has_command powerprofilesctl; then powerprofilesctl get 2>&1 || true; echo; powerprofilesctl list 2>&1 || true
    else echo "power-profiles-daemon CLI not detected"; fi
    echo
    echo "=== InnyGrOS ==="
    echo "Helpers: ${SCRIPTS_DIR}"
    echo "Log: ${LOG_FILE}"
    echo
    echo "This report only reads system information; it does not change settings."
  } > "${report}" 2>&1
  kdialog --title "InnyGrOS System Diagnostics" --textbox "${report}" 760 560 >/dev/null 2>&1 || true
  rm -f -- "${report}"
}

[[ -f "${FIRST_RUN_MARKER}" ]] || first_steps

while true; do
  if [[ -f "${AUTOSTART_FILE}" ]]; then autostart_label="Show Welcome Center at login: ON (select to turn off)"
  else autostart_label="Show Welcome Center at login: OFF (select to turn on)"; fi
  choice="$(kdialog --title "InnyGrOS Welcome Center" --icon innygros --menu \
    "Welcome to InnyGrOS. What would you like to do?" \
    "first-steps" "First steps guide" \
    "settings" "Open System Settings" \
    "discover" "Open Discover (software and updates)" \
    "updater" "Software updater (InnyGrOS / system packages)" \
    "files" "Open File Manager" \
    "desktop-profile" "Apply InnyGrOS desktop profile (reversible)" \
    "desktop-restore" "Restore previous desktop settings" \
    "theme" "Apply InnyGrOS colors" \
    "wallpaper" "Install / apply InnyGrOS wallpaper" \
    "terminal-profile" "Install InnyGrOS terminal theme" \
    "game-readiness" "Check Minecraft / Windows game readiness" \
    "power" "Power mode (battery saver / balanced / performance)" \
    "terminal" "Open Terminal (advanced)" \
    "diagnostics" "View system diagnostics" \
    "benchmark" "Performance snapshot (read-only)" \
    "compare" "Compare last two saved performance snapshots" \
    "hardware" "Laptop hardware check (read-only)" \
    "network" "Network & VPN report (read-only)" \
    "network-health" "Quick connectivity & Tailscale check (read-only)" \
    "battery" "Battery & power health report (read-only)" \
    "autostart" "${autostart_label}" \
    "repo" "Open InnyGrOS project page" \
    "doctor" "Check InnyGrOS installation (doctor)" \
    "about" "About InnyGrOS" \
    "quit" "Exit" 2>/dev/null)" || exit 0
  case "${choice}" in
    first-steps) first_steps ;;
    settings) open_app systemsettings "System Settings" ;;
    discover) open_app plasma-discover "Discover" ;;\n    updater) run_helper "Software updater" software-updater-gui.sh ;;
    files) open_app dolphin "Dolphin File Manager" ;;
    desktop-profile) run_helper "Desktop profile" desktop-profile.sh apply --gui ;;
    desktop-restore) run_helper "Desktop restore" desktop-profile.sh restore --gui ;;
    theme)
      run_helper "Color scheme" apply-theme.sh
      show_info "The InnyGrOS color scheme is installed. If colors did not change, open System Settings → Colors & Themes → Colors and select InnyGrOS."
      ;;
    wallpaper) run_helper "Wallpaper setup" apply-wallpaper.sh ;;
    terminal-profile) run_helper "Terminal theme setup" apply-terminal-profile.sh ;;
    game-readiness) run_helper "Game readiness check" game-readiness.sh ;;
    power) run_helper "Power mode" power-mode.sh choose --gui ;;
    autostart) toggle_autostart ;;
    terminal) open_app konsole "Konsole" ;;
    diagnostics) show_diagnostics ;;
    benchmark) run_helper "Performance snapshot" performance-benchmark.sh --gui ;;
    compare) run_helper "Snapshot comparison" compare-reports.sh --gui ;;
    hardware) run_helper "Hardware check" hardware-check.sh --gui ;;
    network) run_helper "Network & VPN report" network-check.sh --gui ;;
    network-health) run_helper "Network health" network-health.sh ;;
    battery) run_helper "Battery & power report" battery-power-report.sh ;;
    repo)
      if has_command xdg-open; then xdg-open "${REPO_URL}" >/dev/null 2>&1 &
      else show_info "Project: ${REPO_URL}"
      fi
      ;;
    doctor) run_helper "InnyGrOS doctor" doctor.sh --gui ;;
    about) show_info "InnyGrOS ${VERSION} — Desktop Edition\n\nKubuntu + KDE Plasma customization project.\n\nEarly experimental software: changes are limited to your user profile unless you explicitly install packages through system tools.\n\nHelpers: ${SCRIPTS_DIR}\nLog: ${LOG_FILE}" ;;
    quit|"") exit 0 ;;
  esac
done
