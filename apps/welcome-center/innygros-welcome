#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="0.4"
DATA_DIR="${HOME}/.local/share/innygros"
LOG_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/innygros"
LOG_FILE="${LOG_DIR}/welcome-center.log"
REPO_URL="https://github.com/Innygr/InnyGrOS"

# Use the helpers next to this file when it is run from a repository checkout,
# otherwise the copies installed by scripts/install-welcome-center.sh.
SELF_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
if [[ "$(basename -- "${SELF_DIR}")" == welcome-center && -f "${SELF_DIR}/../../scripts/desktop-profile.sh" ]]; then
  BASE_DIR="$(cd -- "${SELF_DIR}/../.." && pwd)"
else
  BASE_DIR="${DATA_DIR}"
fi
SCRIPTS_DIR="${BASE_DIR}/scripts"

if ! command -v kdialog >/dev/null 2>&1; then
  printf 'InnyGrOS Welcome Center needs kdialog. Install it with your graphical software center.\n' >&2
  exit 1
fi
if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
  printf 'InnyGrOS Welcome Center needs a graphical desktop session.\n' >&2
  exit 1
fi

has_command() { command -v "$1" >/dev/null 2>&1; }

show_info() { kdialog --title "InnyGrOS" --msgbox "$1" >/dev/null 2>&1 || true; }

# Show an error with the last lines of a helper's output as expandable details.
show_error() {
  local message="$1" details="${2:-}"
  if [[ -n "${details}" ]]; then
    kdialog --title "InnyGrOS" --detailederror "${message}" "${details}" >/dev/null 2>&1 || true
  else
    kdialog --title "InnyGrOS" --error "${message}" >/dev/null 2>&1 || true
  fi
}

open_app() {
  local app="$1" label="$2"
  if has_command "${app}"; then
    "${app}" >/dev/null 2>&1 </dev/null &
    disown 2>/dev/null || true
  else
    show_info "${label} is not installed. Open Discover to install it."
  fi
}

# Run a bundled helper script. Output goes to a log file (never a terminal
# prompt), stdin is closed so nothing can wait for keyboard input, and a
# failure is shown with the helper's last output lines.
run_helper() {
  local label="$1" script="${SCRIPTS_DIR}/$2"; shift 2
  if [[ ! -f "${script}" ]]; then
    show_error "${label}: helper not found.\n\nExpected: ${script}\n\nRe-run scripts/install-welcome-center.sh from the InnyGrOS repository."
    return 0
  fi
  mkdir -p -- "${LOG_DIR}"
  local output status=0
  output="$(mktemp)"
  bash -- "${script}" "$@" </dev/null >"${output}" 2>&1 || status=$?
  {
    printf '\n=== %s: %s %s (exit %s) ===\n' "$(date '+%F %T')" "$(basename -- "${script}")" "$*" "${status}"
    cat -- "${output}"
  } >> "${LOG_FILE}" 2>/dev/null || true
  if ((status != 0)); then
    show_error "${label} did not complete (exit code ${status}).\n\nFull log: ${LOG_FILE}" "$(tail -n 20 -- "${output}")"
  fi
  rm -f -- "${output}"
  return 0
}

show_diagnostics() {
  local report
  report="$(mktemp)"
  {
    echo "InnyGrOS system diagnostics"
    echo "Generated: $(date)"
    echo
    echo "=== Operating system ==="
    if [[ -r /etc/os-release ]]; then cat /etc/os-release; else echo "OS details unavailable"; fi
    echo
    echo "=== Kernel ==="; uname -a
    echo
    echo "=== CPU ==="; if has_command lscpu; then lscpu; else echo "lscpu not installed"; fi
    echo
    echo "=== Memory ==="; if has_command free; then free -h; else echo "free not installed"; fi
    echo
    echo "=== Storage ==="; if has_command df; then df -h -x tmpfs -x devtmpfs 2>/dev/null || true; fi
    echo
    echo "=== Power profile ==="
    if has_command powerprofilesctl; then powerprofilesctl get 2>&1 || true; echo; powerprofilesctl list 2>&1 || true
    else echo "power-profiles-daemon CLI not detected"; fi
    echo
    echo "=== InnyGrOS ==="
    echo "Helpers: ${SCRIPTS_DIR}"
    echo "Log: ${LOG_FILE}"
    echo
    echo "This report only reads system information; it does not change settings."
  } > "${report}" 2>&1
  kdialog --title "InnyGrOS System Diagnostics" --textbox "${report}" 760 560 >/dev/null 2>&1 || true
  rm -f -- "${report}"
}

while true; do
  choice="$(kdialog --title "InnyGrOS Welcome Center" --menu \
    "Welcome to InnyGrOS. What would you like to do?" \
    "settings" "Open System Settings" \
    "discover" "Open Discover (software and updates)" \
    "files" "Open File Manager" \
    "desktop-profile" "Apply InnyGrOS desktop profile (reversible)" \
    "desktop-restore" "Restore previous desktop settings" \
    "theme" "Apply InnyGrOS colors" \
    "wallpaper" "Install / apply InnyGrOS wallpaper" \
    "terminal-profile" "Install InnyGrOS terminal theme" \
    "game-readiness" "Check Minecraft / Windows game readiness" \
    "terminal" "Open Terminal (advanced)" \
    "diagnostics" "View system diagnostics" \
    "benchmark" "Performance snapshot (read-only)" \
    "repo" "Open InnyGrOS project page" \
    "about" "About InnyGrOS" \
    "quit" "Exit" 2>/dev/null)" || exit 0
  case "${choice}" in
    settings) open_app systemsettings "System Settings" ;;
    discover) open_app plasma-discover "Discover" ;;
    files) open_app dolphin "Dolphin File Manager" ;;
    desktop-profile) run_helper "Desktop profile" desktop-profile.sh apply --gui ;;
    desktop-restore) run_helper "Desktop restore" desktop-profile.sh restore --gui ;;
    theme)
      run_helper "Color scheme" apply-theme.sh
      show_info "The InnyGrOS color scheme is installed. If colors did not change, open System Settings → Colors & Themes → Colors and select InnyGrOS."
      ;;
    wallpaper) run_helper "Wallpaper setup" apply-wallpaper.sh ;;
    terminal-profile) run_helper "Terminal theme setup" apply-terminal-profile.sh ;;
    game-readiness) run_helper "Game readiness check" game-readiness.sh ;;
    terminal) open_app konsole "Konsole" ;;
    diagnostics) show_diagnostics ;;
    benchmark) run_helper "Performance snapshot" performance-benchmark.sh --gui ;;
    repo)
      if has_command xdg-open; then xdg-open "${REPO_URL}" >/dev/null 2>&1 &
      else show_info "Project: ${REPO_URL}"
      fi
      ;;
    about) show_info "InnyGrOS ${VERSION} — Desktop Edition\n\nKubuntu + KDE Plasma customization project.\n\nEarly experimental software: changes are limited to your user profile unless you explicitly install packages through system tools.\n\nHelpers: ${SCRIPTS_DIR}\nLog: ${LOG_FILE}" ;;
    quit|"") exit 0 ;;
  esac
done
