#!/usr/bin/env python3
"""InntegerOS Control Center: unified entry point for InntegerOS desktop tools."""
from __future__ import annotations

import os
import shutil
import subprocess
import threading
import tkinter as tk
from tkinter import messagebox, ttk
from pathlib import Path

TITLE = "InntegerOS Control Center"
BG, CARD, CARD2 = "#080d1c", "#111b31", "#172541"
CYAN, BLUE, PURPLE = "#55eaff", "#388bff", "#a78bfa"
FG, MUTED = "#edf5ff", "#a7b9d5"
HOME = Path.home()
DATA = HOME / ".local/share/innygros"
INT_DATA = HOME / ".local/share/integeros"
LOG = HOME / ".cache/integeros/control-center.log"
REPO = Path(__file__).resolve().parents[2]


def find_script(name: str) -> Path | None:
    for base in (REPO / "scripts", DATA / "scripts"):
        candidate = base / name
        if candidate.is_file():
            return candidate
    return None


def find_app(name: str, *candidates: Path) -> Path | None:
    command = shutil.which(name)
    if command:
        return Path(command)
    return next((p for p in candidates if p.is_file()), None)


class ControlCenter:
    def __init__(self, root: tk.Tk) -> None:
        self.root = root
        root.title(TITLE)
        root.geometry("940x720")
        root.minsize(780, 610)
        root.configure(bg=BG)
        self.status = tk.StringVar(value="InntegerOS is ready.")
        self._style()
        self._header()
        self.tabs = ttk.Notebook(root)
        self.tabs.pack(fill="both", expand=True, padx=20, pady=(4, 10))
        self._build_home(self._page("OVERVIEW"))
        self._build_system(self._page("SYSTEM"))
        self._build_personalization(self._page("DESKTOP"))
        self._build_quick(self._page("QUICK SETTINGS"))
        self._build_blacklight(self._page("BLACKLIGHT"))
        footer = tk.Frame(root, bg=BG)
        footer.pack(fill="x", padx=24, pady=(0, 12))
        tk.Label(footer, textvariable=self.status, bg=BG, fg=MUTED,
                 font=("DejaVu Sans", 8)).pack(side="left")
        tk.Label(footer, text="INTEGEROS • ONE CONTROL CENTER", bg=BG, fg="#7186a8",
                 font=("DejaVu Sans", 8, "bold")).pack(side="right")

    def _style(self) -> None:
        style = ttk.Style()
        style.theme_use("clam")
        style.configure("TNotebook", background=BG, borderwidth=0)
        style.configure("TNotebook.Tab", background=CARD, foreground=MUTED,
                        padding=(16, 10), font=("DejaVu Sans", 9, "bold"))
        style.map("TNotebook.Tab", background=[("selected", "#263957")],
                  foreground=[("selected", CYAN)])

    def _header(self) -> None:
        head = tk.Frame(self.root, bg=BG)
        head.pack(fill="x", padx=28, pady=(20, 8))
        tk.Label(head, text="INTEGEROS // CONTROL CENTER", bg=BG, fg=CYAN,
                 font=("DejaVu Sans", 10, "bold")).pack(anchor="w")
        tk.Label(head, text="Everything in one place.", bg=BG, fg=FG,
                 font=("DejaVu Sans", 24, "bold")).pack(anchor="w", pady=(2, 0))
        tk.Label(head, text="Welcome, customization, system tools and Blacklight controls.",
                 bg=BG, fg=MUTED, font=("DejaVu Sans", 9)).pack(anchor="w")

    def _page(self, title: str) -> tk.Frame:
        outer = tk.Frame(self.tabs, bg=BG)
        canvas = tk.Canvas(outer, bg=BG, highlightthickness=0, borderwidth=0)
        scrollbar = ttk.Scrollbar(outer, orient="vertical", command=canvas.yview)
        inner = tk.Frame(canvas, bg=BG)
        window = canvas.create_window((0, 0), window=inner, anchor="nw")
        inner.bind("<Configure>", lambda _event: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda event: canvas.itemconfigure(window, width=event.width))
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
        self.tabs.add(outer, text=title)
        return inner

    def _section(self, page: tk.Widget, title: str, detail: str = "") -> None:
        tk.Label(page, text=title.upper(), bg=BG, fg=CYAN,
                 font=("DejaVu Sans", 10, "bold")).pack(anchor="w", padx=16, pady=(17, 3))
        if detail:
            tk.Label(page, text=detail, bg=BG, fg=MUTED, wraplength=820,
                     justify="left", font=("DejaVu Sans", 8)).pack(anchor="w", padx=17, pady=(0, 7))

    def _button(self, page: tk.Widget, title: str, detail: str, callback,
                accent: str = BLUE) -> None:
        row = tk.Frame(page, bg=CARD, highlightbackground="#263957", highlightthickness=1)
        row.pack(fill="x", padx=14, pady=4)
        info = tk.Frame(row, bg=CARD)
        info.pack(side="left", fill="both", expand=True, padx=13, pady=8)
        tk.Label(info, text=title, bg=CARD, fg=FG,
                 font=("DejaVu Sans", 9, "bold")).pack(anchor="w")
        tk.Label(info, text=detail, bg=CARD, fg=MUTED, wraplength=610,
                 justify="left", font=("DejaVu Sans", 8)).pack(anchor="w", pady=(2, 0))
        tk.Button(row, text="OPEN", command=callback, bg=CARD2, fg=accent,
                  activebackground="#263957", activeforeground=FG, relief="flat",
                  padx=15, pady=7, cursor="hand2",
                  font=("DejaVu Sans", 8, "bold")).pack(side="right", padx=12, pady=10)

    def _run_script(self, name: str, *args: str) -> None:
        script = find_script(name)
        if not script:
            messagebox.showwarning(TITLE, f"Required InntegerOS component not found: {name}\n\nRun the Control Center installer again.")
            return
        LOG.parent.mkdir(parents=True, exist_ok=True)
        try:
            with LOG.open("a", encoding="utf-8") as log:
                log.write(f"\n=== {name} {' '.join(args)} ===\n")
                subprocess.Popen(["bash", str(script), *args], stdin=subprocess.DEVNULL,
                                 stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
            self.status.set(f"Started {name}.")
        except OSError as exc:
            messagebox.showerror(TITLE, f"Could not start {name}:\n{exc}")

    def _launch(self, command: list[str], label: str) -> None:
        try:
            subprocess.Popen(command, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            self.status.set(f"Opened {label}.")
        except OSError as exc:
            messagebox.showerror(TITLE, f"Could not open {label}:\n{exc}")

    def _open_app(self, command: str, label: str, *paths: Path) -> None:
        target = find_app(command, *paths)
        if target is None:
            messagebox.showinfo(TITLE, f"{label} is not installed. You can install it through Discover.")
            return
        if target.suffix == ".py":
            self._launch(["python3", str(target)], label)
        else:
            self._launch([str(target)], label)

    def _open_settings(self, module: str = "") -> None:
        command = shutil.which("systemsettings")
        if not command:
            messagebox.showinfo(TITLE, "KDE System Settings was not found.")
            return
        self._launch([command] + ([module] if module else []), "KDE System Settings")

