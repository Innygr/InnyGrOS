    def _first_steps(self) -> None:
        choice = messagebox.askyesnocancel(
            TITLE,
            "InntegerOS first steps\n\nYES: save a baseline performance snapshot now.\n"
            "NO: skip the snapshot and continue to the hardware check.\n"
            "CANCEL: close this guide.")
        if choice is None:
            return
        if choice:
            self._run_script("performance-benchmark.sh", "--gui", "--save")
        if messagebox.askyesno(TITLE, "Run the read-only laptop hardware check?"):
            self._run_script("hardware-check.sh", "--gui")
        if messagebox.askyesno(TITLE, "Apply the reversible InntegerOS desktop profile?"):
            self._run_script("desktop-profile.sh", "apply", "--gui")
        if messagebox.askyesno(TITLE, "Open the terminal theme installer?"):
            self._run_script("apply-terminal-profile.sh")
        self.status.set("First steps guide completed.")

