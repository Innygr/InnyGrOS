    def _toggle_autostart(self) -> None:
        path = HOME / ".config/autostart/innygros-welcome.desktop"
        marker = "X-InnyGrOS-Autostart=true"
        if path.is_file():
            content = path.read_text(encoding="utf-8", errors="replace")
            if marker not in content:
                messagebox.showwarning(TITLE, "The existing autostart file was not created by InntegerOS, so it was left unchanged.")
                return
            path.unlink()
            messagebox.showinfo(TITLE, "The Welcome Center will no longer open automatically at login.")
            return
        path.parent.mkdir(parents=True, exist_ok=True)
        executable = HOME / ".local/bin/integeros-control-center"
        path.write_text(
            "[Desktop Entry]\nType=Application\nName=InntegerOS Control Center\n"
            "Comment=Open InntegerOS Control Center at login\n"
            f"Exec={executable}\nIcon=innygros\nTerminal=false\n{marker}\n",
            encoding="utf-8")
        messagebox.showinfo(TITLE, "InntegerOS Control Center will open automatically at login.")

    def _diagnostics(self) -> None:
        import platform
        from datetime import datetime
        from tkinter import scrolledtext
        report = [
            "InntegerOS system diagnostics",
            f"Generated: {datetime.now().astimezone().isoformat(timespec='seconds')}",
            f"System: {platform.platform()}",
            f"Kernel: {platform.release()}",
            f"Python: {platform.python_version()}",
        ]
        for command, title in ((["lscpu"], "CPU"), (["free", "-h"], "Memory"),
                               (["df", "-h", "-x", "tmpfs", "-x", "devtmpfs"], "Storage")):
            report.append(f"\n=== {title} ===")
            if shutil.which(command[0]):
                try:
                    result = subprocess.run(command, capture_output=True, text=True, timeout=8, check=False)
                    report.append(result.stdout.strip() or result.stderr.strip() or "No output.")
                except (OSError, subprocess.TimeoutExpired) as exc:
                    report.append(str(exc))
            else:
                report.append(f"{command[0]} is not installed.")
        window = tk.Toplevel(self.root)
        window.title("InntegerOS System Diagnostics")
        window.geometry("760x560")
        text = scrolledtext.ScrolledText(window, wrap="word", bg="#0b1222", fg=FG,
                                         insertbackground=FG, font=("DejaVu Sans Mono", 9))
        text.pack(fill="both", expand=True, padx=10, pady=10)
        text.insert("1.0", "\n".join(report))
        text.configure(state="disabled")

    def _about(self) -> None:
        version_file = DATA / "VERSION"
        if not version_file.is_file():
            version_file = REPO / "VERSION"
        version = version_file.read_text(encoding="utf-8").strip() if version_file.is_file() else "unknown"
        messagebox.showinfo(TITLE, f"InntegerOS {version} — Desktop Edition\n\nKubuntu + KDE Plasma customization project.\n\nAll major InntegerOS tools are collected in this Control Center.")

