#!/usr/bin/env python3
"""IntegerOS Theme Studio: safe shortcuts for KDE appearance settings."""
from __future__ import annotations

import shutil
import subprocess
import tkinter as tk
from pathlib import Path
from tkinter import messagebox

APP_NAME = "IntegerOS Theme Studio"
COLOR_SCHEME = "InnyGrOS"
WALLPAPER_HELPERS = (
    Path(__file__).resolve().parents[2] / "scripts/apply-wallpaper.sh",
    Path.home() / ".local/share/innygros/scripts/apply-wallpaper.sh",
)


def find_wallpaper_helper() -> Path | None:
    return next((path for path in WALLPAPER_HELPERS if path.is_file()), None)


def run_command(command: list[str], description: str) -> None:
    try:
        result = subprocess.run(command, check=False, text=True, capture_output=True, timeout=90)
    except (OSError, subprocess.TimeoutExpired) as exc:
        messagebox.showerror(APP_NAME, f"{description} could not be started.\n\n{exc}")
        return
    if result.returncode:
        detail = (result.stderr or result.stdout).strip()
        messagebox.showwarning(APP_NAME, f"{description} did not complete.\n\n{detail or 'No details were provided.'}")
    else:
        messagebox.showinfo(APP_NAME, f"{description} completed.")


def open_settings(module: str) -> None:
    executable = shutil.which("systemsettings")
    if not executable:
        messagebox.showerror(APP_NAME, "KDE System Settings (systemsettings) was not found.")
        return
    try:
        subprocess.Popen([executable, module], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:
        messagebox.showerror(APP_NAME, f"Could not open System Settings.\n\n{exc}")


def apply_colors() -> None:
    executable = shutil.which("plasma-apply-colorscheme")
    if not executable:
        messagebox.showwarning(
            APP_NAME,
            "plasma-apply-colorscheme was not found. Open System Settings → Colors & Themes → Colors and select InnyGrOS.",
        )
        open_settings("kcm_colors")
        return
    run_command([executable, COLOR_SCHEME], "Applying the InnyGrOS violet/cyan colour scheme")


def choose_wallpaper() -> None:
    helper = find_wallpaper_helper()
    if helper:
        run_command(["bash", str(helper), "--choose"], "Opening the wallpaper chooser")
        return
    messagebox.showwarning(
        APP_NAME,
        "The IntegerOS wallpaper helper was not found. Open KDE Wallpaper settings to choose an image.",
    )
    open_settings("kcm_wallpaper")


def build_window() -> tk.Tk:
    root = tk.Tk()
    root.title(APP_NAME)
    root.geometry("620x540")
    root.minsize(520, 480)
    root.configure(bg="#090b18")

    title = tk.Label(root, text="THEME STUDIO", bg="#090b18", fg="#55eaff",
                     font=("DejaVu Sans", 22, "bold"))
    title.pack(anchor="w", padx=28, pady=(24, 4))
    subtitle = tk.Label(root, text="Shape the IntegerOS desktop. Changes are made only when you choose an action.",
                        bg="#090b18", fg="#b8bfdc", font=("DejaVu Sans", 10), wraplength=550, justify="left")
    subtitle.pack(anchor="w", padx=30, pady=(0, 20))

    def section(label: str) -> None:
        tk.Label(root, text=label, bg="#090b18", fg="#a58bff",
                 font=("DejaVu Sans", 11, "bold")).pack(anchor="w", padx=30, pady=(10, 5))

    def action(label: str, detail: str, command) -> None:
        row = tk.Frame(root, bg="#151a30", highlightbackground="#30395c", highlightthickness=1)
        row.pack(fill="x", padx=28, pady=4)
        text_box = tk.Frame(row, bg="#151a30")
        text_box.pack(side="left", fill="both", expand=True, padx=12, pady=9)
        tk.Label(text_box, text=label, bg="#151a30", fg="#f1f3ff",
                 font=("DejaVu Sans", 10, "bold")).pack(anchor="w")
        tk.Label(text_box, text=detail, bg="#151a30", fg="#aeb7d4",
                 font=("DejaVu Sans", 9), wraplength=350, justify="left").pack(anchor="w", pady=(2, 0))
        tk.Button(row, text="OPEN", command=command, bg="#24304d", fg="#55eaff",
                  activebackground="#35466e", activeforeground="#ffffff",
                  relief="flat", padx=14, pady=7, cursor="hand2").pack(side="right", padx=12)

    section("INTEGEROS LOOK")
    action("Violet / cyan colour scheme", "Apply the existing InnyGrOS KDE colour scheme.", apply_colors)
    action("Desktop wallpaper", "Choose an image using the existing safe wallpaper helper.", choose_wallpaper)

    section("MORE KDE APPEARANCE")
    action("Icons", "Browse installed icon themes and choose one.", lambda: open_settings("kcm_icons"))
    action("Cursor", "Change the pointer theme and size.", lambda: open_settings("kcm_cursortheme"))
    action("Global theme", "Explore Plasma layouts and global themes.", lambda: open_settings("kcm_lookandfeel"))
    action("Fonts", "Adjust interface and application fonts.", lambda: open_settings("kcm_fonts"))

    footer = tk.Label(root, text="No system-wide files are modified. KDE manages the settings opened here.",
                      bg="#090b18", fg="#7f89a8", font=("DejaVu Sans", 8), wraplength=550)
    footer.pack(anchor="w", padx=30, pady=(18, 12))
    return root


if __name__ == "__main__":
    build_window().mainloop()
